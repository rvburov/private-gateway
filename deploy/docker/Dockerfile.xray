FROM docker.io/library/python:3.13-slim-trixie@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f

RUN groupadd --gid 10001 gateway && useradd --uid 10001 --gid gateway --create-home gateway
COPY --chmod=0555 bin/xray /usr/local/bin/xray
COPY --chmod=0555 docker/xray-worker.py /usr/local/bin/xray-worker.py
USER 10001:10001
EXPOSE 443
HEALTHCHECK --interval=10s --timeout=3s --retries=6 \
  CMD ["python3", "-c", "from pathlib import Path; assert Path('/state/xray.status.json').is_file()"]
ENTRYPOINT ["python3", "/usr/local/bin/xray-worker.py"]
