[Unit]
Description=Private Gateway management API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gateway
Group=gateway
WorkingDirectory=/opt/private-gateway
EnvironmentFile=/etc/private-gateway/gateway.env
ExecStart=/opt/private-gateway/bin/gateway-api serve
Restart=on-failure
RestartSec=5s
UMask=0077
StateDirectory=private-gateway
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
# Keep /run/user sockets reachable for a reviewed rootless Podman/Xray setup.
ProtectHome=read-only
ReadWritePaths=/var/lib/private-gateway
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
