[Unit]
Description=Private Gateway management API
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=gateway
Group=gateway
WorkingDirectory=/opt/private-gateway/current
EnvironmentFile=/etc/private-gateway/gateway.env
ExecStart=/opt/private-gateway/current/bin/gateway-api serve
Restart=on-failure
RestartSec=5s
UMask=0077
StateDirectory=private-gateway
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/private-gateway
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
