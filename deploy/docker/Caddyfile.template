{
    # A subscription link carries its secret in the path, and a failed request is logged with
    # its URI: the log keeps everything else. There is no access log at all.
    log default {
        format filter {
            wrap json
            fields {
                request>uri delete
            }
        }
    }
}

https://__PANEL_DOMAIN__ {
    handle_path /browser/* {
        forward_auth api:8080 {
            uri /browser-authorization
        }
        reverse_proxy browser:6080 {
            header_up -Cookie
            header_up -Authorization
        }
    }

    handle {
        reverse_proxy api:8080
    }
}

https://__PANEL_DOMAIN__:8443 {
    redir https://__PANEL_DOMAIN__{uri} permanent
}
