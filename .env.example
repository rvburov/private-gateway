# Local development only. Copy to .env; never commit .env or keygen output.
POSTGRES_PASSWORD=change-this-local-password
GATEWAY_DATABASE_URL=postgres://gateway:change-this-local-password@127.0.0.1:5432/gateway?sslmode=disable

# Fill these from `gateway-api keygen`; master_key is standard base64, 32 bytes.
GATEWAY_API_TOKEN=
# Optional locally; production values are created by admin-credentials.py on the VPS.
GATEWAY_ADMIN_USERNAME=
GATEWAY_ADMIN_PASSWORD_HASH=
GATEWAY_ADMIN_TOTP_SECRET=
GATEWAY_MASTER_KEY=
GATEWAY_REALITY_PRIVATE_KEY=
GATEWAY_SHORT_ID=

GATEWAY_LISTEN=127.0.0.1:8080
GATEWAY_HOST=vpn.example.com
GATEWAY_PORT=8443
GATEWAY_SERVER_NAME=www.cloudflare.com
GATEWAY_REALITY_TARGET=www.cloudflare.com:443
GATEWAY_XRAY_CONFIG=.local/xray.json
GATEWAY_XRAY_LISTEN=0.0.0.0
GATEWAY_XRAY_BINARY=xray
# JSON argv, executed without a shell. Set a fixed, reviewed restart command.
GATEWAY_XRAY_RESTART=
GATEWAY_WEB_DIR=web/dist

# Production Docker worker settings; local development can leave them empty.
GATEWAY_BROWSER_WORKER_URL=
GATEWAY_BROWSER_WORKER_TOKEN=
GATEWAY_BROWSER_PUBLIC_URL=

# Необязательный ключ IP2Location.io: только API-серверу, без него расширенные сведения недоступны.
GATEWAY_IP2LOCATION_API_KEY=
